{"Vector3Value", {"Value:Vector3"}},
{"CFrameValue", {"Value:CFrame"}},
{"BaseScript", {"Disabled:bool"}},
{"Script", {"RunContext:token"}},
{"Lighting", {"Ambient:Color3", "OutdoorAmbient:Color3", "ColorShift_Bottom:Color3", "ColorShift_Top:Color3", "Brightness:float", "GlobalShadows:bool", "FogColor:Color3", "FogStart:float", "FogEnd:float", "GeographicLatitude:float", "TimeOfDay:string", "EnvironmentDiffuseScale:float", "EnvironmentSpecularScale:float", "ExposureCompensation:float", "ShadowSoftness:float", "Technology:token"}},
{"Atmosphere", {"Color:Color3", "Decay:Color3", "Density:float", "Offset:float", "Glare:float", "Haze:float"}},
{"Sky", {"SkyboxBk:Content", "SkyboxDn:Content", "SkyboxFt:Content", "SkyboxLf:Content", "SkyboxRt:Content", "SkyboxUp:Content", "CelestialBodiesShown:bool", "StarCount:int", "SunTextureId:Content", "MoonTextureId:Content"}},
