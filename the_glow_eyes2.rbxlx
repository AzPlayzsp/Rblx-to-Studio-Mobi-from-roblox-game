<ProtectedString name="Source"><![CDATA[
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Door = script.Parent
local ClickDetector = Door:WaitForChild("ClickDetector")
local Key = Door:WaitForChild("Key")
local KeyDor = Door:WaitForChild("KeyDor")

local Duration = 1

local OriginalPivot = Door:GetPivot()
local OpenPivot = OriginalPivot * CFrame.Angles(0, math.rad(-90), 0)

local Unlocked = false
local IsOpen = false
local Busy = false

local function CreateSound(Name, Id)
    local Sound = Instance.new("Sound")
    Sound.Name = Name
    Sound.SoundId = "rbxassetid://" .. Id
    Sound.Parent = Door
    return Sound
end

local OpenSound = CreateSound("Open Door", "101186488177415")
local CloseSound = CreateSound("Close Door", "75935302971787")
local UnlockedSound = CreateSound("Unlocked Door", "85947633367352")

local function Unlock()
    if Unlocked then return end
    
    Unlocked = true
    
    local Weld = KeyDor:FindFirstChildOfClass("WeldConstraint")
    
    if Weld then
        Weld:Destroy()
    end
    
    UnlockedSound:Play()
end

local function HasKey(Player)
    local Backpack = Player:FindFirstChildOfClass("Backpack")
    local Character = Player.Character
    
    if Backpack and Backpack:FindFirstChild(Key.Value) then
        return true
    end
    
    if Character and Character:FindFirstChild(Key.Value) then
        return true
    end
    
    return false
end

local function PlayTween(Target, Sound, Opening)
    if Busy then return end
    
    Busy = true
    Sound:Play()
    
    local StartPivot = Door:GetPivot()
    local Alpha = Instance.new("NumberValue")
    Alpha.Value = 0
    
    local Connection = Alpha.Changed:Connect(function(Value)
        Door:PivotTo(StartPivot:Lerp(Target, Value))
    end)
    
    local Tween = TweenService:Create(
    Alpha,
    TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
    {Value = 1}
    )
    
    Tween:Play()
    Tween.Completed:Wait()
    
    Door.CanCollide = not Opening
    
    Connection:Disconnect()
    Alpha:Destroy()
    
    Busy = false
end

ClickDetector.MouseClick:Connect(function(Player)
    if Busy then return end
    
    if not Unlocked then
        if HasKey(Player) then
            Unlock()
        end
        
        return
    end
    
    if not IsOpen then
        IsOpen = true
        PlayTween(OpenPivot, OpenSound, true)
    else
        IsOpen = false
        PlayTween(OriginalPivot, CloseSound, false)
    end
end)

Door.Touched:Connect(function(Hit)
    if Unlocked then return end
    
    local Character = Hit:FindFirstAncestorOfClass("Model")
    local Player = Character and Players:GetPlayerFromCharacter(Character)
    
    if not Player then return end
    
    local Tool = Character:FindFirstChildOfClass("Tool")
    
    if Tool and Tool.Name == Key.Value then
        Unlock()
    end
end)

]]></ProtectedString>
