{"GuiObject", {"Active:bool", "AnchorPoint:Vector2", "BackgroundColor3:Color3", "BackgroundTransparency:float", "BorderColor3:Color3", "BorderSizePixel:int", "ClipsDescendants:bool", "LayoutOrder:int", "Position:UDim2", "Rotation:float", "Size:UDim2", "SizeConstraint:token", "Visible:bool", "ZIndex:int", "AutomaticSize:token"}},
