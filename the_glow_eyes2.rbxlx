{"UIPadding", {"PaddingLeft:UDim", "PaddingRight:UDim", "PaddingTop:UDim", "PaddingBottom:UDim"}},
{"UIScale", {"Scale:float"}},
{"UIAspectRatioConstraint", {"AspectRatio:float"}},
{"UIGradient", {"Offset:Vector2", "Rotation:float", "Enabled:bool"}},
}
 
local function parse(list)
    local out = {}
    for _, s in ipairs(list) do
        local name, kind, xml = s:match("^([^:]+):([^:]+):?(.*)$")
        if xml == nil or xml == "" then
            xml = name
        end
        out[#out + 1] = {name = name, kind = kind, xml = xml}
    end
    return out
end
 
for _, g in ipairs(GROUPS) do
    g.class = g[1]
    g.props = parse(g[2])
end
 
local cache = {}
local skipped = {}
local pieces = {}
local total = 0
local done = 0
local statusLabel
 
local function index(o, n)
    return o[n]
end
 
local function allowed(inst, countSkip)
    local cls = inst.ClassName
    if SKIP[cls] then
        if countSkip then
            skipped[cls] = (skipped[cls] or 0) + 1
        end
        return false
    end
    if not inst.Archivable then
        return false
    end
    if inst:IsA("Model") and Players:GetPlayerFromCharacter(inst) then
        return false
    end
    return true
end
 
local function assignRefs(inst)
    total += 1
    refs[inst] = "RBX" .. total
    if total % 300 == 0 then
        statusLabel.Text = "Mengumpulkan item: " .. total
        task.wait()
    end
    for _, c in ipairs(inst:GetChildren()) do
        if allowed(c, true) then
            assignRefs(c)
        end
    end
end
 
local function emit(inst)
    local cls = inst.ClassName
    local plist = cache[cls]
    if not plist then
        plist = {}
        for _, g in ipairs(GROUPS) do
            if inst:IsA(g.class) then
                for _, p in ipairs(g.props) do
                    plist[#plist + 1] = p
                end
            end
        end
        cache[cls] = plist
    end
    local lines = {'<Item class="' .. cls .. '" referent="' .. refs[inst] .. '">', "<Properties>", W.string("Name", inst.Name)}
    for _, p in ipairs(plist) do
        local ok, v = pcall(index, inst, p.name)
        if ok and v ~= nil then
            local ok2, s = pcall(W[p.kind], p.xml, v)
            if ok2 then
                lines[#lines + 1] = s
            end
        end
    end
    if inst:IsA("LuaSourceContainer") then
        local ok, src = pcall(index, inst, "Source")
        lines[#lines + 1] = W.ProtectedString("Source", ok and src or "")
    end
    lines[#lines + 1] = "</Properties>"
    pieces[#pieces + 1] = table.concat(lines, "\n") .. "\n"
    done += 1
    if done % 150 == 0 then
        statusLabel.Text = "Memproses: " .. done .. " / " .. total
        task.wait()
    end
    for _, c in ipairs(inst:GetChildren()) do
        if allowed(c, false) then
            emit(c)
        end
    end
    pieces[#pieces + 1] = "</Item>\n"
end
 
local function paginate(footer)
    local result = {}
    local buf = {HEADER}
    local size = #HEADER
    for _, s in ipairs(pieces) do
        if size + #s > UKURAN_HALAMAN and #buf > 0 and size > 0 then
            result[#result + 1] = table.concat(buf)
            buf = {}
            size = 0
        end
        buf[#buf + 1] = s
        size += #s
    end
    buf[#buf + 1] = footer
    result[#result + 1] = table.concat(buf)
    return result
end
 
local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do
        o[k] = v
    end
    o.Parent = parent
    return o
end
 
local function makeButton(text, pos, size, parent, color)
    local b = make("TextButton", {
    Text = text,
    Position = pos,
    Size = size,
    BackgroundColor3 = color or Color3.fromRGB(70, 70, 80),
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.GothamBold,
    TextSize = 14,
    AutoButtonColor = true,
    }, parent)
    make("UICorner", {CornerRadius = UDim.new(0, 8)}, b)
    return b
end
 
local gui = make("ScreenGui", {Name = "ExportRBXL", ResetOnSpawn = false, DisplayOrder = 50}, playerGui)
 
local toggle = makeButton("Export RBXL", UDim2.new(1, -120, 0.5, 40), UDim2.new(0, 110, 0, 34), gui, Color3.fromRGB(255, 140, 0))
 
local panel = make("Frame", {
Name = "Panel",
AnchorPoint = Vector2.new(0.5, 0.5),
Position = UDim2.new(0.5, 0, 0.5, 0),
Size = UDim2.new(0.92, 0, 0.85, 0),
BackgroundColor3 = Color3.fromRGB(30, 30, 36),
Visible = false,
}, gui)
make("UICorner", {CornerRadius = UDim.new(0, 12)}, panel)
 
make("TextLabel", {
Text = "Export ke RBXLX",
Position = UDim2.new(0, 0, 0, 0),
Size = UDim2.new(1, 0, 0.07, 0),
BackgroundTransparency = 1,
TextColor3 = Color3.new(1, 1, 1),
Font = Enum.Font.GothamBold,
TextSize = 18,
}, panel)
 
statusLabel = make("TextLabel", {
Text = "Tekan Convert untuk mulai",
Position = UDim2.new(0.02, 0, 0.07, 0),
Size = UDim2.new(0.96, 0, 0.07, 0),
BackgroundTransparency = 1,
TextColor3 = Color3.fromRGB(200, 200, 210),
Font = Enum.Font.Gotham,
TextSize = 12,
TextWrapped = true,
TextXAlignment = Enum.TextXAlignment.Left,
}, panel)
 
local convertBtn = makeButton("Convert", UDim2.new(0.02, 0, 0.15, 0), UDim2.new(0.31, 0, 0.08, 0), panel, Color3.fromRGB(255, 140, 0))
local selectBtn = makeButton("Pilih Semua", UDim2.new(0.345, 0, 0.15, 0), UDim2.new(0.31, 0, 0.08, 0), panel)
local closeBtn = makeButton("Tutup", UDim2.new(0.67, 0, 0.15, 0), UDim2.new(0.31, 0, 0.08, 0), panel, Color3.fromRGB(170, 60, 60))
 
local prevBtn = makeButton("<", UDim2.new(0.02, 0, 0.25, 0), UDim2.new(0.2, 0, 0.07, 0), panel)
local pageLabel = make("TextLabel", {
Text = "Halaman 0 / 0",
Position = UDim2.new(0.24, 0, 0.25, 0),
Size = UDim2.new(0.52, 0, 0.07, 0),
BackgroundTransparency = 1,
TextColor3 = Color3.new(1, 1, 1),
Font = Enum.Font.GothamBold,
TextSize = 14,
}, panel)
local nextBtn = makeButton(">", UDim2.new(0.78, 0, 0.25, 0), UDim2.new(0.2, 0, 0.07, 0), panel)
 
local box = make("TextBox", {
Text = "",
Position = UDim2.new(0.02, 0, 0.34, 0),
Size = UDim2.new(0.96, 0, 0.64, 0),
BackgroundColor3 = Color3.fromRGB(18, 18, 22),
TextColor3 = Color3.fromRGB(230, 230, 235),
Font = Enum.Font.Code,
TextSize = 11,
ClearTextOnFocus = false,
MultiLine = true,
TextWrapped = false,
ClipsDescendants = true,
TextXAlignment = Enum.TextXAlignment.Left,
TextYAlignment = Enum.TextYAlignment.Top,
}, panel)
make("UICorner", {CornerRadius = UDim.new(0, 8)}, box)
 
local pages = {}
local current = 1
local busy = false
 
local function showPage(i)
    if #pages == 0 then
        return
    end
    current = math.clamp(i, 1, #pages)
    box.Text = pages[current]
    pageLabel.Text = "Halaman " .. current .. " / " .. #pages
end
 
local function convert()
    if busy then
        return
    end
    busy = true
    convertBtn.Text = "Memproses..."
    pages = {}
    refs = {}
    skipped = {}
    cache = {}
    pieces = {}
    total = 0
    done = 0
    box.Text = ""
    pageLabel.Text = "Halaman 0 / 0"
    statusLabel.Text = "Mengumpulkan item..."
    local ok, err = pcall(function()
        local roots = {}
        for _, name in ipairs(SERVICES) do
            local good, svc = pcall(game.GetService, game, name)
            if good and svc then
                roots[#roots + 1] = svc
                assignRefs(svc)
            end
        end
        for _, svc in ipairs(roots) do
            emit(svc)
        end
        pages = paginate("</roblox>\n")
        pieces = {}
    end)
    if ok then
        local extra = {}
        for cls, n in pairs(skipped) do
            extra[#extra + 1] = cls .. " x" .. n
        end
        local note = ""
        if #extra > 0 then
            note = " | Dilewati: " .. table.concat(extra, ", ")
        end
        statusLabel.Text = "Selesai: " .. done .. " item, " .. #pages .. " halaman" .. note
        showPage(1)
    else
        statusLabel.Text = "Error: " .. tostring(err)
    end
    convertBtn.Text = "Convert"
    busy = false
end
 
toggle.Activated:Connect(function()
    panel.Visible = not panel.Visible
end)
 
closeBtn.Activated:Connect(function()
    panel.Visible = false
end)
 
convertBtn.Activated:Connect(function()
    task.spawn(convert)
end)
 
prevBtn.Activated:Connect(function()
    showPage(current - 1)
end)
 
nextBtn.Activated:Connect(function()
    showPage(current + 1)
end)
 
selectBtn.Activated:Connect(function()
    box:CaptureFocus()
    task.wait()
    box.SelectionStart = 1
    box.CursorPosition = #box.Text + 1
end)

]]></ProtectedString>
