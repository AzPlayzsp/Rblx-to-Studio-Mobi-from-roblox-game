<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454101691AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ClientActionEventLocal</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[--ClientActionEventLocal	-   This script is remote called from the server to create, update or delete something on the client side.
--                         It is most often used to show or update Guis on the client, but can be used to create/update/destroy other
--                         types of Instances, like Parts.  Remember, parts created on the client are only visible to that client.
--                                                                ScottSpiritWalker, 03/18/2023.

--  This copy of the script is only used by the Publish module to determine if the script is Enabled.  
--  The real script is in StarterCharacterScripts.
--  The Source is in ScriptSource.

local Debris = game:GetService("Debris")
--print("ClientAction finding...")
local ClientAction = game:GetService("ReplicatedStorage"):WaitForChild("ClientAction",99999)  

local action, instance, pathString

--print("ClientAction listening...")

ClientAction.OnClientEvent:Connect(function(t)   --t is a table with keys: action, instance, path, and several properties=values, like the example below.
	--Example:FireClient(player, action="update", instance="TextLabel", path="ScreenGui.Status", Text = "Intermission", TextColor3 = Color3.fromRGB(255,0,0))
	--print("ClientAction t: ",t)
	local success,errorMsg = pcall(function()
		action = t["action"] or ''
		t["action"] = nil
		instance = t["instance"] or ''
		t["instance"] = nil
		pathString = t["path"] or ''
		t["path"] = nil
		
		local path = game
		for i,p in pairs(pathString:split(".")) do   --Collect all the path descendants.
			if i == 1 then	
				if p == "game" then
					--omit "game".
				elseif p == "player" then
					path = game.Players.LocalPlayer
				elseif p == "ScreenGui" then
					path = game.Players.LocalPlayer:WaitForChild("PlayerGui",9):WaitForChild("ScreenGui",9)
				elseif p == "PlayerGui" then
					path = game.Players.LocalPlayer:WaitForChild("PlayerGui",9)
				else
					path = path[p]    --Append them to the path.
				end
			else
				if p == "LocalPlayer" then
					path = game.Players.LocalPlayer
				else
					if path:WaitForChild(p,1) then
						path = path[p]    --Append them to the path.
					else
						error('Problem in '..script.Name..'.  '..p..' does not exist in path="'..pathString..'"')
					end
				end
			end
		end
		if action == "update" then
			for k,v in pairs(t) do
				path[k] = v			--Set property values.
			end
		elseif action == "append" then  --Just like update except it will append Text to the existing Text property. 
			for k,v in pairs(t) do
				if k == "Text" then
					path[k] ..= v	
				else
					path[k] = v	 --Set property values.
				end	
			end
		elseif action == "create" then
			local it = Instance.new(instance)
			for k,v in pairs(t) do
				it[k] = v			--Set property values.
			end
		elseif action == "delete" then
			Debris:AddItem(path,.01)
		else
			error('Expected action = "update", "create", or "delete"')			
		end
	end)
	if not success then
		pcall(function()
			local player = game.Players.LocalPlayer
			local OutputFrame = player.PlayerGui:WaitForChild("StudioGui",9):WaitForChild("OutputFrame")
			OutputFrame:WaitForChild("ScrollingFrame"):WaitForChild("ErrorTextLabel").Text ..= script.Name..' had trouble with :FireClient action="'..action..'", pathString="'..pathString..'".  Error:' .. errorMsg:gsub("<","&lt;") .. "\n"
			OutputFrame.Visible = true
		end)
	end	
end)]]></ProtectedString>
