<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454101687AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ConvertToRblx</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local UKURAN_HALAMAN = 40000
 
local SERVICES = {"Workspace", "Lighting", "ReplicatedFirst", "ReplicatedStorage", "StarterGui", "StarterPack", "StarterPlayer", "SoundService"}
 
local SKIP = {Terrain = true, UnionOperation = true, NegateOperation = true, IntersectOperation = true, PartOperation = true}
 
local HEADER = '<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">\n<Meta name="ExplicitAutoJoints">true</Meta>\n'
 
 
local function clean(s)
    return (s:gsub("%c", function(c)
        if c == "\t" or c == "\n" or c == "\r" then
            return c
        end
        return ""
    end))
end
 
local AMP = "&"
local LT = "<"
local CDATA_OPEN = LT .. "![CDATA["
local CDATA_CLOSE = "]]" .. ">"
 
local function ent(name)
    return AMP .. name .. ";"
end
 
local function esc(s)
    s = tostring(s)
    s = s:gsub(AMP, ent("amp"))
    s = s:gsub(LT, ent("lt"))
    s = s:gsub(">", ent("gt"))
    s = s:gsub('"', ent("quot"))
    s = clean(s)
    return s
end
 
local function fnum(n)
    if n ~= n then return "0" end
    if n == math.huge then return "INF" end
    if n == -math.huge then return "-INF" end
    return string.format("%.9g", n)
end
 
local function toByte(x)
    return math.clamp(math.floor(x * 255 + 0.5), 0, 255)
end
 
local W = {}
 
W.string = function(n, v)
    return '<string name="' .. n .. '">' .. esc(v) .. "</string>"
end
 
W.bool = function(n, v)
    return '<bool name="' .. n .. '">' .. (v and "true" or "false") .. "</bool>"
end
 
W.float = function(n, v)
    return '<float name="' .. n .. '">' .. fnum(v) .. "</float>"
end
 
W.double = function(n, v)
    return '<double name="' .. n .. '">' .. fnum(v) .. "</double>"
end
 
W.int = function(n, v)
    return '<int name="' .. n .. '">' .. fnum(math.floor(v)) .. "</int>"
end
 
W.token = function(n, v)
    return '<token name="' .. n .. '">' .. tostring(v.Value) .. "</token>"
end
 
W.Color3 = function(n, v)
    return '<Color3 name="' .. n .. '"><R>' .. fnum(v.R) .. "</R><G>" .. fnum(v.G) .. "</G><B>" .. fnum(v.B) .. "</B></Color3>"
end
 
W.Color3uint8 = function(n, v)
    local packed = 4278190080 + toByte(v.R) * 65536 + toByte(v.G) * 256 + toByte(v.B)
    return '<Color3uint8 name="' .. n .. '">' .. string.format("%.0f", packed) .. "</Color3uint8>"
end
 
W.Vector3 = function(n, v)
    return '<Vector3 name="' .. n .. '"><X>' .. fnum(v.X) .. "</X><Y>" .. fnum(v.Y) .. "</Y><Z>" .. fnum(v.Z) .. "</Z></Vector3>"
end
 
W.Vector2 = function(n, v)
    return '<Vector2 name="' .. n .. '"><X>' .. fnum(v.X) .. "</X><Y>" .. fnum(v.Y) .. "</Y></Vector2>"
end
 
W.UDim = function(n, v)
    return '<UDim name="' .. n .. '"><S>' .. fnum(v.Scale) .. "</S><O>" .. fnum(v.Offset) .. "</O></UDim>"
end
 
W.UDim2 = function(n, v)
    return '<UDim2 name="' .. n .. '"><XS>' .. fnum(v.X.Scale) .. "</XS><XO>" .. fnum(v.X.Offset) .. "</XO><YS>" .. fnum(v.Y.Scale) .. "</YS><YO>" .. fnum(v.Y.Offset) .. "</YO></UDim2>"
end
 
W.CFrame = function(n, v)
    local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = v:GetComponents()
    return '<CoordinateFrame name="' .. n .. '"><X>' .. fnum(x) .. "</X><Y>" .. fnum(y) .. "</Y><Z>" .. fnum(z) .. "</Z><R00>" .. fnum(r00) .. "</R00><R01>" .. fnum(r01) .. "</R01><R02>" .. fnum(r02) .. "</R02><R10>" .. fnum(r10) .. "</R10><R11>" .. fnum(r11) .. "</R11><R12>" .. fnum(r12) .. "</R12><R20>" .. fnum(r20) .. "</R20><R21>" .. fnum(r21) .. "</R21><R22>" .. fnum(r22) .. "</R22></CoordinateFrame>"
end
 
W.Content = function(n, v)
    if v == "" then
        return '<Content name="' .. n .. '"><null></null></Content>'
    end
    return '<Content name="' .. n .. '"><url>' .. esc(v) .. "</url></Content>"
end
 
local refs = {}
 
W.Ref = function(n, v)
    return '<Ref name="' .. n .. '">' .. (refs[v] or "null") .. "</Ref>"
end
 
W.ProtectedString = function(n, v)
    v = tostring(v)
    v = clean(v)
    v = v:gsub("%]%]>", "]]" .. CDATA_CLOSE .. CDATA_OPEN .. ">")
    return '<ProtectedString name="' .. n .. '">' .. CDATA_OPEN .. v .. CDATA_CLOSE .. "</ProtectedString>"
end
 
local TEXTP = {"Text:string", "TextColor3:Color3", "TextSize:int", "TextScaled:bool", "TextWrapped:bool", "TextXAlignment:token", "TextYAlignment:token", "Font:token", "TextTransparency:float", "RichText:bool", "TextStrokeTransparency:float", "TextStrokeColor3:Color3"}
 
local IMAGEP = {"Image:Content", "ImageColor3:Color3", "ImageTransparency:float", "ScaleType:token"}
 
local GROUPS = {
{"Workspace", {"Gravity:float", "FallenPartsDestroyHeight:float"}},
{"Camera", {"CFrame:CFrame", "FieldOfView:float"}},
{"BasePart", {"Anchored:bool", "CanCollide:bool", "CanTouch:bool", "CanQuery:bool", "CastShadow:bool", "Massless:bool", "Locked:bool", "Transparency:float", "Reflectance:float", "Color:Color3uint8:Color3uint8", "Material:token", "Size:Vector3:size", "CFrame:CFrame", "TopSurface:token", "BottomSurface:token", "LeftSurface:token", "RightSurface:token", "FrontSurface:token", "BackSurface:token", "CollisionGroup:string"}},
{"Part", {"Shape:token"}},
{"MeshPart", {"MeshId:Content", "TextureID:Content", "RenderFidelity:token", "CollisionFidelity:token"}},
{"SpawnLocation", {"Neutral:bool", "Duration:int", "Enabled:bool"}},
{"Seat", {"Disabled:bool"}},
{"Model", {"PrimaryPart:Ref"}},
{"Decal", {"Texture:Content", "Face:token", "Transparency:float", "Color3:Color3", "ZIndex:int"}},
{"Texture", {"StudsPerTileU:float", "StudsPerTileV:float"}},
{"SpecialMesh", {"MeshType:token", "MeshId:Content", "TextureId:Content", "Scale:Vector3", "Offset:Vector3"}},
{"Attachment", {"CFrame:CFrame", "Visible:bool"}},
{"JointInstance", {"Part0:Ref", "Part1:Ref", "C0:CFrame", "C1:CFrame", "Enabled:bool"}},
{"WeldConstraint", {"Part0:Ref", "Part1:Ref", "Enabled:bool"}},
{"Constraint", {"Attachment0:Ref", "Attachment1:Ref", "Enabled:bool", "Visible:bool"}},
{"Humanoid", {"Health:float", "MaxHealth:float", "WalkSpeed:float", "JumpPower:float", "HipHeight:float", "RigType:token", "DisplayName:string"}},
{"Tool", {"CanBeDropped:bool", "RequiresHandle:bool", "ToolTip:string", "Grip:CFrame"}},
{"Sound", {"SoundId:Content", "Volume:float", "Looped:bool", "PlaybackSpeed:float", "RollOffMaxDistance:float", "RollOffMinDistance:float"}},
{"Light", {"Brightness:float", "Color:Color3", "Enabled:bool", "Shadows:bool"}},
{"PointLight", {"Range:float"}},
{"SpotLight", {"Range:float", "Angle:float", "Face:token"}},
{"SurfaceLight", {"Range:float", "Angle:float", "Face:token"}},
{"StringValue", {"Value:string"}},
{"IntValue", {"Value:int"}},
{"NumberValue", {"Value:double"}},
