<Item class="Script" referent="RBX66C1625455D04AC580D8101139513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">System</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[ 
local TweenService = game:GetService("TweenService")
 
local Door = script.Parent
local ClickDetector = Door:WaitForChild("ClickDetector")
 
local Duration = 1
 
local OriginalPivot = Door:GetPivot()
local OpenPivot = OriginalPivot * CFrame.Angles(0, math.rad(-90), 0)
 
local IsOpen = false
local Busy = false
 
local function CreateSound(Name, Id)
    local Sound = Instance.new("Sound")
    Sound.Name = Name
    Sound.SoundId = "rbxassetid://" .. Id
    Sound.Parent = Door
    return Sound
end
 
local OpenSound = CreateSound("Open Door", "101186488177415")
local CloseSound = CreateSound("Close Door", "75935302971787")
 
local function PlayTween(Target, Sound, Opening)
    if Busy then return end
    
    Busy = true
    Sound:Play()
    
    local StartPivot = Door:GetPivot()
    local Alpha = Instance.new("NumberValue")
    Alpha.Value = 0
    
    local Connection = Alpha.Changed:Connect(function(Value)
        Door:PivotTo(StartPivot:Lerp(Target, Value))
    end)
    
    local Tween = TweenService:Create(
    Alpha,
    TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
    {Value = 1}
    )
    
    Tween:Play()
    Tween.Completed:Wait()
    
    Door.CanCollide = not Opening
    
    Connection:Disconnect()
    Alpha:Destroy()
    
    Busy = false
end
 
ClickDetector.MouseClick:Connect(function()
    if Busy then return end
    
    if not IsOpen then
        IsOpen = true
        PlayTween(OpenPivot, OpenSound, true)
    else
        IsOpen = false
        PlayTween(OriginalPivot, CloseSound, false)
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8011400041fa</UniqueId>
